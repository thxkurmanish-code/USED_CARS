# Environment used by Docker Compose for local development.
POSTGRES_DB=dream_car_bazaar
POSTGRES_USER=dreamcar
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://dreamcar:change-this-local-password@postgres:5432/dream_car_bazaar
REDIS_URL=redis://redis:6379/0
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret-before-production
FRONTEND_ORIGIN=http://localhost:3000

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
