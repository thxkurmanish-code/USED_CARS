# ===================================================================
# Dream Car Bazaar — Production & Local Development Environment Template
# ===================================================================

# Environment Mode ("development", "test", or "production")
APP_ENV=development

# Core Backend Configuration
APP_NAME="Dream Car Bazaar API"
APP_SECRET_KEY=replace-with-a-64-char-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_DB=dream_car_bazaar
POSTGRES_USER=dreamcar
POSTGRES_PASSWORD=change-this-secure-password-before-production
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dreamcar:change-this-secure-password-before-production@postgres:5432/dream_car_bazaar

# Redis Cache Configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Production Admin User Configuration
# Set these when deploying for the business owner so seed script builds the initial admin account safely
PRODUCTION_ADMIN_EMAIL=dreamcarsbazzaar@gmail.com
PRODUCTION_ADMIN_PASSWORD=SetYourOwnerPasswordHere123!


# AWS S3 / S3-Compatible Object Storage (R2 / DigitalOcean Spaces / MinIO)
# Leave blank during local development to store files on local disk in /uploads/
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=us-east-1
S3_PUBLIC_CUSTOM_DOMAIN=

# Docker Compose Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend Environment Variable
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
